{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",

    "target": "ES2023",

    "rootDir": "./src",
    "outDir": "./dist",

    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "skipLibCheck": true,
    "incremental": true,
    "forceConsistentCasingInFileNames": true
  },

  "exclude": [
    "node_modules",
    "test",
    "**/*.spec.ts",
    "**/*.e2e-spec.ts",
    "dist"
  ]
}